// =============================================================================
// EMPIRE FRONTIER - database schema
// =============================================================================
// Conventions
//   * camelCase fields in Prisma, snake_case tables/columns via @map/@@map.
//   * Every table carries createdAt/updatedAt.
//   * Money-like values (coins, gems, real-money minor units) are BigInt.
//     Stockpiled resources are Int - they are hard-capped by storage anyway.
//   * Anything a client could lie about (balances, ownership, battle outcome)
//     is written only by server-side services inside a transaction.
//   * Ledger tables (CurrencyTransaction, MarketplaceTransaction, Payment,
//     AuditLog) are append-only. Never UPDATE a ledger row.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native", "linux-musl-openssl-3.0.x"]
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // citext gives us case-insensitive unique emails/usernames without having to
  // remember to lower() at every call site.
  extensions = [citext, pg_trgm]
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
