{
  "name": "@empire/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Empire Frontier game client - React + Three.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@empire/game-data": "*",
    "@empire/game-engine": "*",
    "@empire/shared": "*",
    "@empire/ui": "*",
    "@react-three/drei": "^10.0.4",
    "@react-three/fiber": "^9.1.0",
    "clsx": "^2.1.1",
    "react": "~19.2.0",
    "react-dom": "~19.2.0",
    "react-router-dom": "^7.3.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.174.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.12",
    "@types/node": "^22.13.9",
    "@types/react": "~19.2.0",
    "@types/react-dom": "~19.2.0",
    "@types/three": "^0.174.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.0.0",
    "tailwindcss": "^4.0.12",
    "typescript": "^5.7.3",
    "vite": "^6.2.1",
    "vitest": "^3.0.8"
  }
}
