# =============================================================================
# EMPIRE FRONTIER - environment template
# Copy to .env  ->  cp .env.example .env
# NEVER commit the real .env file. Rotate every secret before going to prod.
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
NODE_ENV=development
COMPOSE_PROJECT_NAME=empire-frontier
TZ=UTC

# ---- Public entrypoints (through NGINX) --------------------------------------
HTTP_PORT=80
API_URL=http://localhost/api
WEB_URL=http://localhost
ADMIN_URL=http://localhost/admin
CORS_ORIGIN=http://localhost,http://localhost:80

# ---- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=empire
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_DB=empire_frontier
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Host-side port for a local SQL client (dev only, bound to 127.0.0.1).
# Offset from 5432 so it never clashes with a PostgreSQL install on your machine.
POSTGRES_HOST_PORT=5433
# Containers talk over the docker network by service name - never localhost.
DATABASE_URL=postgresql://empire:change_me_postgres_password@postgres:5432/empire_frontier?schema=public&connection_limit=20&pool_timeout=20

# ---- Redis -------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
# Host-side port for redis-cli (dev only, bound to 127.0.0.1).
REDIS_HOST_PORT=6380
REDIS_PASSWORD=change_me_redis_password
REDIS_URL=redis://:change_me_redis_password@redis:6379

# ---- Auth / crypto -----------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=change_me_jwt_access_secret_at_least_32_chars_long
JWT_REFRESH_SECRET=change_me_jwt_refresh_secret_at_least_32_chars_long
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
SESSION_SECRET=change_me_session_secret_at_least_32_chars_long
BCRYPT_ROUNDS=12

# ---- Google OAuth (optional; leave blank to disable the provider) ------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost/api/v1/auth/google/callback

# ---- Mail (dev writes verification / reset links to the API log) -------------
MAIL_DRIVER=log
MAIL_FROM="Empire Frontier <no-reply@empire-frontier.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# ---- Payments (Phase 7) ------------------------------------------------------
# PAYMENT_PROVIDER=razorpay | stripe | none
PAYMENT_PROVIDER=none
PAYMENT_CURRENCY=INR
PAYMENT_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ---- Object storage (dev MinIO, optional profile) ----------------------------
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=empire-assets
S3_ACCESS_KEY=empire_minio
S3_SECRET_KEY=change_me_minio_password
S3_FORCE_PATH_STYLE=true

# ---- Rate limiting -----------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=180
AUTH_RATE_LIMIT_MAX=10

# ---- Seed / bootstrap admin --------------------------------------------------
# Leave SEED_ADMIN_PASSWORD empty and the seed generates a random one and prints
# it once to the log. Never hardcode a real password here.
SEED_ADMIN_EMAIL=admin@empire-frontier.local
SEED_ADMIN_USERNAME=overseer
SEED_ADMIN_PASSWORD=

# ---- Observability -----------------------------------------------------------
LOG_LEVEL=debug
LOG_PRETTY=true
SWAGGER_ENABLED=true

# ---- Game tuning defaults (overridable at runtime from the admin panel) ------
GAME_TICK_SECONDS=5
STARTER_COINS=5000
STARTER_GEMS=50
MARKETPLACE_FEE_BPS=500
